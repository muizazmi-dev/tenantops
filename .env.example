# ============================================================================
# TenantOps — root env
# Copy to .env for local docker-compose; each service also has its own .env.example
# ============================================================================

# ---- SQL (Azure SQL Edge for local; Azure SQL Database in cloud) -----------
SQL_SA_PASSWORD=Your_Strong_Passw0rd!
SQL_CONNECTION_STRING=Server=sql,1433;Database=tenantops;User Id=sa;Password=Your_Strong_Passw0rd!;TrustServerCertificate=True;Encrypt=False;

# ---- Microsoft Entra ID (OIDC) ---------------------------------------------
# Create an app registration: https://learn.microsoft.com/entra/identity-platform/quickstart-register-app
ENTRA_TENANT_ID=common
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-me
ENTRA_AUDIENCE=api://tenantops
ENTRA_ISSUER=https://login.microsoftonline.com/common/v2.0

# ---- Local fallback JWT (ASP.NET Identity) ---------------------------------
LOCAL_JWT_ISSUER=https://tenantops.local/identity
LOCAL_JWT_AUDIENCE=tenantops-api
LOCAL_JWT_KEY=dev-only-do-not-use-in-prod-min-32-chars-xxxxxxxxxx

# ---- Azure OpenAI -----------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-aoai.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Azure AI Search --------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_ADMIN_KEY=replace-me
AZURE_SEARCH_INDEX=tenantops-kb
AZURE_SEARCH_API_VERSION=2025-09-01

# ---- Service URLs (container-internal for compose) --------------------------
TENANT_API_BASE_URL=http://tenant-api:8080
CORE_API_BASE_URL=http://core-api:8080
AI_API_BASE_URL=http://ai-orchestrator:8080
IDENTITY_API_BASE_URL=http://identity-api:8080

# ---- Next.js (exposed to browser) -------------------------------------------
NEXT_PUBLIC_APP_NAME=TenantOps
NEXT_PUBLIC_APIM_BASE_URL=http://localhost:8000
# In Azure this becomes https://api.yourdomain.com (Front Door -> APIM)

# ---- APIM (simulated locally via direct service calls; real in Azure) ------
APIM_SUBSCRIPTION_KEY=local-dev-key
